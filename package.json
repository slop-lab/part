  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-isolation=none tests/*.test.mjs",
    "check": "tsc --noEmit && node scripts/check-architecture.mjs",
    "example": "npm run build && node examples/basic.mjs",
    "test:consumers": "npm run build && node scripts/test-consumers.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "preview": "npm run preview:build && node scripts/serve-preview.mjs",
    "measure": "npm run build && node scripts/measure.mjs",
    "format": "prettier --write src tests scripts examples consumers experiments docs README.md CHANGELOG.md package.json tsconfig.json .github",
    "format:check": "prettier --check src tests scripts examples consumers experiments docs README.md CHANGELOG.md package.json tsconfig.json .github",

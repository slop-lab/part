{
  "schemaVersion": 1,
  "name": "uppercase-tool-flow",
  "exchanges": [
    {
      "id": "choose-uppercase-tool",
      "request": {
        "stream": true,
        "stream_options": {
          "include_usage": true
        },
        "model": "part-mock",
        "messages": [
          {
            "role": "user",
            "content": "Uppercase hello using the uppercase tool."
          }
        ],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "uppercase",
              "description": "Convert text to uppercase",
              "parameters": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": ["text"],
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "reply": {
        "kind": "completion",
        "content": null,
        "toolCalls": [
          {
            "id": "call_uppercase",
            "name": "uppercase",
            "arguments": "{\"text\":\"hello\"}"
          }
        ]
      }
    },
    {
      "id": "summarize-tool-result",
      "request": {
        "stream": true,
        "stream_options": {
          "include_usage": true
        },
        "model": "part-mock",
        "messages": [
          {
            "role": "user",
            "content": "Uppercase hello using the uppercase tool."
          },
          {
            "role": "assistant",
            "content": ""
          },
          {
            "role": "assistant",
            "content": null,
            "tool_calls": [
              {
                "id": "call_uppercase",
                "type": "function",
                "function": {
                  "name": "uppercase",
                  "arguments": "{\"text\":\"hello\"}"
                }
              }
            ]
          },
          {
            "role": "tool",
            "content": "\"HELLO\"",
            "tool_call_id": "call_uppercase"
          }
        ],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "uppercase",
              "description": "Convert text to uppercase",
              "parameters": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": ["text"],
                "additionalProperties": false
              }
            }
          }
        ]
      },
      "reply": {
        "kind": "completion",
        "content": "HELLO",
        "textChunks": ["HEL", "LO"],
        "usage": {
          "prompt_tokens": 30,
          "completion_tokens": 2,
          "total_tokens": 32
        }
      }
    }
  ]
}
